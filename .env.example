# Copy to .env (gitignored) and fill in. Never commit real keys.

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8081

# Neon Postgres: pooled connection for the app, direct connection for migrations
DATABASE_URL=
DIRECT_URL=

# Sign in with Google (web OAuth client)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (Services ID, client-secret JWT from scripts/apple-client-secret.mjs, app bundle ID)
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_APP_BUNDLE_IDENTIFIER=com.cielolearn.app
